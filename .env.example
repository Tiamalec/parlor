# Local AI Agent Chatroom configuration
# Copy to .env and change all secrets before first use.
# The standard-library implementation may parse this file itself, or variables
# can be exported with: set -a; source .env; set +a

# Chat server
CHAT_HOST=127.0.0.1
CHAT_PORT=8765
CHAT_BACKLOG=100
CHAT_HEARTBEAT_SECONDS=30
CHAT_IDLE_TIMEOUT_SECONDS=90
MAX_FRAME_BYTES=4194304
MAX_IMAGE_BYTES=2097152

# Client connection and reconnect policy
CLIENT_HOST=127.0.0.1
CLIENT_PORT=8765
CLIENT_RECONNECT_INITIAL_SECONDS=1
CLIENT_RECONNECT_MAX_SECONDS=10

# Persistent data (relative paths are resolved from the project root)
CHAT_DATA_DIR=./data
SQLITE_BUSY_TIMEOUT_MS=5000

# Bootstrap administrator
# This sample password is intentionally unsafe. Replace it in the local .env.
CHAT_ADMIN_USERNAME=admin
CHAT_ADMIN_PASSWORD=change-me-before-first-run
PASSWORD_PBKDF2_ITERATIONS=310000

# Initial model configuration. The admin console manages persisted profiles after first start.
AGENT_ENABLED=true
AGENT_PROVIDER=ollama
AGENT_BASE_URL=http://127.0.0.1:11434
AGENT_API_KEY=
AGENT_MODEL=chatroom-qwen3.5-4b
AGENT_REASONING_EFFORT=none
AGENT_TEMPERATURE=0.2
AGENT_CONTEXT_TOKENS=8192
AGENT_INPUT_BUDGET_TOKENS=6000
AGENT_MAX_OUTPUT_TOKENS=512
AGENT_MAX_CONCURRENCY=1
AGENT_TIMEOUT_SECONDS=45
AGENT_DEFAULT_HISTORY_LIMIT=50
AGENT_MAX_HISTORY_LIMIT=200
AGENT_HEALTHCHECK_SECONDS=30
AGENT_CLOUD_FALLBACK=false
# Only used when AGENT_CLOUD_FALLBACK=true. Keep blank for local-only mode.
AGENT_FALLBACK_BASE_URL=
AGENT_FALLBACK_API_KEY=
AGENT_FALLBACK_MODEL=

# Independent Web admin console. The built-in listener is loopback-only.
# For remote access, keep ADMIN_HOST on loopback and terminate HTTPS in a
# trusted reverse proxy; then set ADMIN_COOKIE_SECURE=true.
ADMIN_ENABLED=true
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8766
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOG_CAPACITY=500
ADMIN_COOKIE_SECURE=false
ADMIN_MAX_BODY_BYTES=65536

# Application behavior
MESSAGE_RECALL_WINDOW_SECONDS=120
HISTORY_PAGE_SIZE=100
HISTORY_MAX_SEARCH_RESULTS=200
AGENT_SCHEDULE_MIN_MINUTES=1
AGENT_SCHEDULE_MAX_MINUTES=1440
LOG_LEVEL=INFO
